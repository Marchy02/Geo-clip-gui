# Copia questo file in .env e personalizza. Tutte le voci sono facoltative.
# I provider IA si configurano più comodamente dalla dashboard: scheda Impostazioni > Provider IA.
# Ciò che salvi lì ha la precedenza su questo file.

# --- Arbitro IA: provider Gemini predefinito — chiave gratuita su https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Verifica online con Google Search (true/false)
GEMINI_SEARCH=true

# Chiavi standard degli altri provider (lette se il provider non ha una chiave salvata)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Id del provider predefinito e timeout delle chiamate (secondi)
# AI_PROVIDER=gemini
AI_TIMEOUT=120

# Posizione del file delle impostazioni salvate dalla dashboard (default: ~/.config/geoosint/settings.json)
# GEOOSINT_CONFIG=
# true = impostazioni in sola lettura dalla dashboard (consigliato se la esponi in rete)
# GEOOSINT_SETTINGS_LOCKED=false

# --- GeoCLIP: world (mondo) | ukraine_russia (modello regionale)
GEOCLIP_PRESET=world
GEOCLIP_TOP_K=5

# --- OCR (codici EasyOCR separati da virgola) e YOLO
OCR_LANGUAGES=en,it,de,fr,es
OCR_CONF=0.2
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.35

# --- Servizi online (reverse geocoding OpenStreetMap). false = modalità totalmente offline
ONLINE_LOOKUPS=true
HTTP_TIMEOUT=10

# --- Output e server
REPORTS_DIR=reports
MAX_IMAGE_MB=40
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false
